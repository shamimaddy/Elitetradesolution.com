{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/privacy", "destination": "/privacy-policy", "statusCode": 301 },
    { "source": "/disclaimer", "destination": "/disclosures", "statusCode": 301 },
    { "source": "/risk-disclosure", "destination": "/disclosures", "statusCode": 301 },
    { "source": "/terms-disclaimer", "destination": "/disclosures", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
